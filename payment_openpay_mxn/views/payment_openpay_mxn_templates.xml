<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="openpay_mxn_redirect_form" name="Openpay MXN payment transition">
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="reference" t-att-value="reference"/>
        </form>
    </template>

    <template id="openpay_mxn_state_header" inherit_id="payment.state_header">
        <xpath expr="//t[@t-set='waiting_heading']" position="replace">
            <t t-set="waiting_heading">
                <p t-if="tx.provider_code == 'openpay_mxn'" class="mb-0">Referencia SPEI/CIE generada</p>
                <p t-else="" class="mb-0">Please wait...</p>
            </t>
        </xpath>
        <xpath expr="//a[@t-att-href='tx.landing_route']" position="replace">
            <a t-if="is_processing and tx.provider_code == 'openpay_mxn'"
               t-att-href="tx.landing_route"
               class="btn btn-primary btn-sm ms-auto text-nowrap shadow-sm"
            >
                Continuar <i class="oi oi-arrow-right ms-1 small"/>
            </a>
            <a t-if="is_processing and tx.provider_code != 'openpay_mxn'"
               t-att-href="tx.landing_route"
               class="alert-link ms-auto text-nowrap"
            >
                Skip <i class="oi oi-arrow-right ms-1 small"/>
            </a>
        </xpath>
    </template>

    <template id="openpay_mxn_payment_status" inherit_id="payment.payment_status">
        <xpath expr="//t[@t-call='payment.state_header']" position="after">
            <section t-if="tx and tx.provider_code == 'openpay_mxn' and tx.openpay_mxn_reference"
                     class="card border-0 shadow-sm mb-3 overflow-hidden"
            >
                <div class="card-body p-3 p-md-4">
                    <div class="row g-4 align-items-start">
                        <div class="col-md-5">
                            <span class="badge text-bg-primary mb-2">TRANSFERENCIA SPEI/CIE</span>
                            <h2 class="h5 mb-2">Datos listos para transferir</h2>
                            <p class="text-muted mb-3">
                                Transfiere el importe exacto con los datos de la derecha. Confirmaremos tu pedido automáticamente cuando Openpay reciba el pago.
                            </p>
                            <div class="bg-light rounded-3 p-3">
                                <span class="small text-muted d-block">Importe a transferir</span>
                                <strong class="fs-4" t-field="tx.amount" t-options="{'widget': 'monetary', 'display_currency': tx.currency_id}"/>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="border rounded-3 p-3 h-100">
                                <h3 class="h6 text-uppercase text-muted mb-3">Instrucciones de pago</h3>
                                <dl class="row mb-3">
                                    <dt class="col-sm-5 fw-normal text-muted">Banco destino</dt>
                                    <dd class="col-sm-7 fw-semibold"><t t-esc="tx.openpay_mxn_bank"/></dd>
                                    <dt class="col-sm-5 fw-normal text-muted">CLABE</dt>
                                    <dd class="col-sm-7 font-monospace text-break fw-semibold"><t t-esc="tx.openpay_mxn_clabe"/></dd>
                                    <dt class="col-sm-5 fw-normal text-muted">Convenio CIE</dt>
                                    <dd class="col-sm-7 font-monospace text-break fw-semibold"><t t-esc="tx.openpay_mxn_agreement"/></dd>
                                    <dt class="col-sm-5 fw-normal text-muted">Referencia / concepto</dt>
                                    <dd class="col-sm-7 font-monospace text-break fw-bold"><t t-esc="tx.openpay_mxn_reference"/></dd>
                                </dl>
                                <a t-if="tx.openpay_mxn_receipt_url"
                                   t-att-href="tx.openpay_mxn_receipt_url"
                                   target="_blank"
                                   rel="noopener"
                                   class="btn btn-outline-primary btn-sm"
                                >
                                    <i class="fa fa-file-text-o me-1"/> Abrir recibo de Openpay
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>

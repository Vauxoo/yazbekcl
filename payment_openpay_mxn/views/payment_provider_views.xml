<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_openpay_mxn" model="ir.ui.view">
        <field name="name">Openpay MXN Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group name="openpay_mxn_credentials" invisible="code != 'openpay_mxn'" groups="base.group_system">
                    <field name="openpay_mxn_merchant_id"/>
                    <field name="openpay_mxn_private_key" password="True"/>
                    <field name="openpay_mxn_webhook_user"/>
                    <field name="openpay_mxn_webhook_password" password="True"/>
                    <div class="text-muted" colspan="2">
                        Webhook: /payment/openpay_mxn/webhook (HTTPS y HTTP Basic).
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>

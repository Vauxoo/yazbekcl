<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_openpay_mxn" model="payment.provider">
        <field name="name">Openpay México - SPEI/CIE</field>
        <field name="code">openpay_mxn</field>
        <field name="state">disabled</field>
        <field name="is_published">False</field>
        <field name="pending_msg"><![CDATA[
            <p>Tu referencia bancaria fue generada. El pedido se confirmará cuando Openpay notifique el pago.</p>
        ]]></field>
    </record>
    <record id="ir_cron_openpay_mxn_refresh" model="ir.cron">
        <field name="name">Openpay MXN: actualizar transferencias pendientes</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_openpay_mxn_refresh_pending()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
